# ------------------------------------------------------------------
# evidence-sourcing-agent 运行配置
# ------------------------------------------------------------------

# demo（默认）：离线确定性运行，评分/核验由服务端裁决，不调用任何外部服务。
# remote：启用 LLM 摘要。评分/状态/证据仍由服务端裁决；LLM 输出受 JSON Schema 约束。
LLM_MODE=demo

# OpenAI 兼容网关（默认 DeepSeek，可换成任意兼容端点）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
